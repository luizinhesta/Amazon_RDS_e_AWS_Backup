# ============================================
# .env.example — Backend (AWS Lambda / Node.js)
# ============================================
# Em producao, estas variaveis sao definidas no Console da Lambda:
#   Lambda -> Configuracao -> Variaveis de ambiente
# (veja IMPLANTACAO.md — Etapa 8.1, Parte B).
#
# Este arquivo serve como referencia e para testes locais. Copie para
# "backend/.env" e preencha com os valores reais.
#   cp .env.example .env        (Linux/Mac)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# ATENCAO / SECURITY:
# NUNCA versione o .env real. A senha do banco (RDS_PASSWORD) deve ser obtida
# do AWS Secrets Manager e mantida igual a senha do PostgreSQL.
# ============================================

# ---- Amazon RDS (PostgreSQL via RDS Proxy) ----

# Endpoint do RDS Proxy (usado para ESCRITA)
RDS_PROXY_ENDPOINT=<RDS_PROXY_ENDPOINT>

# Endpoint da Replica de Leitura (usado para LEITURA)
RDS_REPLICA_ENDPOINT=<RDS_ENDPOINT_REPLICA>

# Porta do PostgreSQL
RDS_PORT=5432

# Nome do banco de dados
RDS_DATABASE=dinogame

# Usuario da aplicacao no banco
RDS_USER=dinogame_app

# Senha do banco — OBTER DO SECRETS MANAGER (nunca commitar valor real)
RDS_PASSWORD=<RDS_PASSWORD>

# ---- Amazon ElastiCache (Redis) ----

# Endpoint do ElastiCache
CACHE_ENDPOINT=<ELASTICACHE_ENDPOINT>

# Porta do Redis
CACHE_PORT=6379

# Usar TLS na conexao com o cache (true/false)
CACHE_TLS=true

# TTL das sessoes de jogo em segundos (1800 = 30 min)
GAME_SESSION_TTL=1800

# ---- CORS ----

# Origens permitidas (separadas por virgula), ex.: https://d123abc.cloudfront.net
# localhost:5173 ja e permitido por padrao no codigo para desenvolvimento
ALLOWED_ORIGINS=https://<DOMINIO_APLICACAO>

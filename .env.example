# ============================================
# .env.example — Frontend (React + Vite)
# ============================================
# Copie este arquivo para ".env" na raiz do projeto e preencha os valores reais.
#   cp .env.example .env        (Linux/Mac)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# ATENCAO / SECURITY:
# Variaveis com prefixo VITE_ sao incorporadas ao bundle JavaScript durante o
# build e ficam VISIVEIS no navegador. NUNCA coloque aqui senhas, endpoints
# privados do RDS, ARNs de segredos ou chaves AWS.
# ============================================

# Regiao AWS dos recursos (ex.: us-east-1)
VITE_AWS_REGION=us-east-1

# Amazon Cognito — ID do User Pool (ex.: us-east-1_XXXXXXXXX)
VITE_COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID>

# Amazon Cognito — ID do App Client do User Pool
VITE_COGNITO_USER_POOL_CLIENT_ID=<COGNITO_USER_POOL_CLIENT_ID>

# URL base do API Gateway (stage dev)
# Formato: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
VITE_API_URL=https://<API_GATEWAY_URL>
